# 应用环境变量模板
# 复制此文件为 .env 并填写实际值

# 应用配置
APP_NAME=家校互通
DEBUG=true
ENV=development
BACKEND_PORT=8000

# MySQL 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=jiaxiaohutong

# JWT 密钥 (生产环境请更换为强密钥)
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS 允许的来源 (逗号分隔)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
